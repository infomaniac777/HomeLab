# All dotfiles and dotfolders except specific ones we want to track
.*
!.gitignore

# Certificate and key files
*.cert
*.key

# Audio files
*.wav

# Tracing files
FlameGraph/

# Python cache files
*.pyc

# Home Assistant log and database files
homeassistant/config/home-assistant.log
homeassistant/config/home-assistant.log.1
homeassistant/config/home-assistant_v2.db
